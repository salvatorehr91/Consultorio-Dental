<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui_ClinicaDental.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui_ClinicaDental.Pages"
    Title="Consultorio Dental">

    <ShellContent
        Title="Menu"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <!-- 2026-11-20 (menú): acceso directo a todas las pantallas.
         "Inicio" vuelve a la pantalla principal. Las rutas son
         absolutas (//): cada toque aterriza limpio en esa pantalla,
         sin apilar copias encima de la anterior. -->
    <MenuItem Text="Inicio"
              CommandParameter="MainPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Pacientes"
              CommandParameter="PacientesPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Citas"
              CommandParameter="CitasPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Pagos"
              CommandParameter="PagosPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Dentistas"
              CommandParameter="DentistasPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Tratamientos"
              CommandParameter="TratamientosPage"
              Clicked="IrPagina_Clicked" />
    <MenuItem Text="Reportes"
              CommandParameter="ReportesPage"
              Clicked="IrPagina_Clicked" />
    <!-- 2026-11-21 (bitácora): solo Admin (el handler avisa si
         no lo es, igual que Administrar usuarios). -->
    <MenuItem Text="Bitácora"
              Clicked="VerBitacora_Clicked" />

    <!-- 2026-11-25 (actualización): revisión manual de una nueva
         versión. La automática corre sola al abrir la app. -->
    <!--<MenuItem Text="Buscar actualización"
              Clicked="BuscarActualizacion_Clicked" />-->

    <!-- 2026-11-20 (usuarios): solo Admin (el handler avisa si
         no lo es). Cerrar sesión va después. -->
    <MenuItem Text="Administrar usuarios"
              Clicked="AdministrarUsuarios_Clicked" />

    <!-- 2026-11-20 (login): cierra la sesión y vuelve a LoginPage. -->
    <MenuItem Text="Cerrar sesión"
              Clicked="CerrarSesion_Clicked" />

</Shell>
