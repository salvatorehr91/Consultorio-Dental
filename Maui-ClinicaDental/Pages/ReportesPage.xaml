<?xml version="1.0" encoding="utf-8" ?>
<!-- ReportesPage.xaml — Reportes del consultorio (.NET MAUI)
     2026-11-19: totales por día/mes, tratamientos más usados y
     citas por dentista. El período por defecto es el mes en curso.
     Las listas usan BindableLayout dentro del ScrollView, no
     CollectionView: son listas cortas (días del mes, tratamientos,
     dentistas) y así la página entera se desplaza sin el problema
     de altura infinita que tenían CitasPage y PagosPage.
     2026-11-20: las columnas numéricas tienen ancho FIJO (no Auto):
     cada renglón es un Grid distinto y con Auto cada uno medía sus
     columnas por su cuenta, así que las cantidades se amontonaban
     sin alinearse con el encabezado. Con ancho fijo y números
     alineados a la derecha, encabezado y renglones coinciden. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Maui_ClinicaDental.Models"
             x:Class="Maui_ClinicaDental.Pages.ReportesPage"
             Title="Reportes"
             BackgroundColor="#F4F7F9">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <Label Text="Reportes"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#0F3556" />

            <Label Text="{Binding AvisoApi}"
                   IsVisible="{Binding TieneAvisoApi}"
                   FontSize="12"
                   TextColor="#8A6D00"
                   BackgroundColor="#FFF3CD"
                   Padding="10,6" />

            <!-- 2026-11-25 (loading): se ve mientras se valida el acceso al API. -->
            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               IsVisible="{Binding EstaCargando}"
                               Color="#0E7C7B" />
            <!-- Período -->
            <Border Padding="14,12" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Período" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Desde" FontSize="12" TextColor="#5A6B7A" />
                            <DatePicker Date="{Binding Desde, Mode=TwoWay}"
                                        BackgroundColor="White"
                                        TextColor="Black" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Hasta" FontSize="12" TextColor="#5A6B7A" />
                            <DatePicker Date="{Binding Hasta, Mode=TwoWay}"
                                        BackgroundColor="White"
                                        TextColor="Black" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="Actualizar reportes"
                            Command="{Binding ActualizarCommand}"
                            BackgroundColor="#0E7C7B"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Resumen -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Border Padding="14,12" BackgroundColor="White">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding TotalCobradoTexto}" FontSize="22" FontAttributes="Bold" TextColor="#0F3556" HorizontalOptions="Center" />
                        <Label Text="Total cobrado" FontSize="12" TextColor="#5A6B7A" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="14,12" BackgroundColor="White">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CantidadPagosTexto}" FontSize="22" FontAttributes="Bold" TextColor="#0F3556" HorizontalOptions="Center" />
                        <Label Text="Pagos" FontSize="12" TextColor="#5A6B7A" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Padding="14,12" BackgroundColor="White">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding TotalCitasTexto}" FontSize="22" FontAttributes="Bold" TextColor="#0F3556" HorizontalOptions="Center" />
                        <Label Text="Citas" FontSize="12" TextColor="#5A6B7A" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14,12" BackgroundColor="White">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding PromedioTexto}" FontSize="22" FontAttributes="Bold" TextColor="#0F3556" HorizontalOptions="Center" />
                        <Label Text="Promedio por pago" FontSize="12" TextColor="#5A6B7A" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding CitasPorEstadoTexto}"
                   FontSize="13"
                   TextColor="#5A6B7A"
                   IsVisible="{Binding TieneResumen}" />

            <!-- Cobros por día -->
            <Label Text="Cobros por día" FontSize="18" FontAttributes="Bold" TextColor="#0F3556" />
            <Border Padding="14,12" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,70,90" ColumnSpacing="12">
                        <Label Text="Fecha" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" />
                        <Label Grid.Column="1" Text="Pagos" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Total" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#D6DEE5" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CobrosPorDia}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CobroPorDiaDto">
                                <Grid ColumnDefinitions="*,70,90" ColumnSpacing="12">
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd MMM yyyy}'}" FontSize="14" TextColor="#1A2B3C" />
                                    <Label Grid.Column="1" Text="{Binding CantidadPagos}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Total, StringFormat='${0:0.00}'}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Sin cobros en ese período."
                           FontSize="13"
                           TextColor="#7A8A99"
                           IsVisible="{Binding SinCobros}" />
                </VerticalStackLayout>
            </Border>

            <!-- Tratamientos más usados -->
            <Label Text="Tratamientos más usados" FontSize="18" FontAttributes="Bold" TextColor="#0F3556" />
            <Border Padding="14,12" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,60,90" ColumnSpacing="12">
                        <Label Text="Tratamiento" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" />
                        <Label Grid.Column="1" Text="Veces" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Total" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#D6DEE5" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TratamientosMasUsados}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TratamientoUsoDto">
                                <Grid ColumnDefinitions="*,60,90" ColumnSpacing="12">
                                    <Label Text="{Binding Nombre}" FontSize="14" TextColor="#1A2B3C" />
                                    <Label Grid.Column="1" Text="{Binding Veces}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding TotalCobrado, StringFormat='${0:0.00}'}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Sin tratamientos en ese período."
                           FontSize="13"
                           TextColor="#7A8A99"
                           IsVisible="{Binding SinTratamientos}" />
                </VerticalStackLayout>
            </Border>

            <!-- Citas por dentista -->
            <Label Text="Citas por dentista" FontSize="18" FontAttributes="Bold" TextColor="#0F3556" />
            <Border Padding="14,12" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,55,95,85" ColumnSpacing="12">
                        <Label Text="Dentista" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" />
                        <Label Grid.Column="1" Text="Citas" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Completadas" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                        <Label Grid.Column="3" Text="Canceladas" FontSize="12" FontAttributes="Bold" TextColor="#5A6B7A" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#D6DEE5" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CitasPorDentista}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CitasPorDentistaDto">
                                <Grid ColumnDefinitions="*,55,95,85" ColumnSpacing="12">
                                    <Label Text="{Binding DentistaNombre}" FontSize="14" TextColor="#1A2B3C" />
                                    <Label Grid.Column="1" Text="{Binding TotalCitas}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Completadas}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding Canceladas}" FontSize="14" TextColor="#1A2B3C" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Sin citas en ese período."
                           FontSize="13"
                           TextColor="#7A8A99"
                           IsVisible="{Binding SinCitasPorDentista}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
