<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui_ClinicaDental.Pages.NuevoPacientePage"
             Title="Nuevo Paciente"
             BackgroundColor="#F4F7F9">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <VerticalStackLayout Spacing="2">
                <Label Text="Nuevo paciente"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#0F3556" />
                <Label Text="Nombre y apellido son obligatorios. El resto es opcional."
                       FontSize="14"
                       TextColor="#5A6B7A" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nombre *" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                    <Entry Placeholder="Ej.: María"
                           Text="{Binding Nombre}"
                           BackgroundColor="White" 
                           TextColor="Black" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Apellido *" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                    <Entry Placeholder="Ej.: López"
                           Text="{Binding Apellido}"
                           BackgroundColor="White"
                           TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Fecha de nacimiento" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                <DatePicker Date="{Binding FechaNacimiento}"
                            BackgroundColor="White" 
                            TextColor="Black" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Teléfono" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                <Entry Placeholder="Ej.: 555-1001"
                       Keyboard="Telephone"
                       Text="{Binding Telefono}"
                       BackgroundColor="White" 
                       TextColor="Black" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Email" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                <Entry Placeholder="Ej.: maria@test.com"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       BackgroundColor="White" 
                       TextColor="Black" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Dirección" FontSize="13" FontAttributes="Bold" TextColor="#0F3556" />
                <Editor Placeholder="Calle, número, colonia (opcional)"
                        Text="{Binding Direccion}"
                        AutoSize="TextChanges"
                        BackgroundColor="White" 
                        TextColor="Black" />
            </VerticalStackLayout>

            <Label Text="{Binding MensajeError}"
                   FontSize="13"
                   TextColor="#B3261E"
                   IsVisible="{Binding TieneError}" />
            <!-- 2026-11-25 (loading): se ve mientras se valida el acceso al API. -->
            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               IsVisible="{Binding EstaCargando}"
                               Color="#0E7C7B" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="White"
                        TextColor="#0F3556"
                        BorderColor="#D6DEE5"
                        BorderWidth="1"
                        CornerRadius="10"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="Guardar paciente"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding PuedeGuardar}"
                        BackgroundColor="#0E7C7B"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="48" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
