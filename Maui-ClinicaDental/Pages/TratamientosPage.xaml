<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui_ClinicaDental.Pages.TratamientosPage"
             Title="Tratamientos"
             BackgroundColor="#F4F7F9">

    <!-- 2026-11-19: la raíz es un Grid, no un VerticalStackLayout.
         Con VerticalStackLayout el CollectionView pedía altura infinita
         y con muchos tratamientos la lista no desplazaba (mismo
         problema que CitasPage). La lista vive en la fila "*" (acotada,
         con scroll propio). -->
    <Grid Padding="20,16"
          RowSpacing="14"
          RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Start">
            <VerticalStackLayout Spacing="2">
                <Label Text="Tratamientos"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#0F3556" />
                <Label Text="{Binding TotalTratamientosTexto}"
                       FontSize="14"
                       TextColor="#5A6B7A" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="＋ Nuevo"
                    Command="{Binding NuevoTratamientoCommand}"
                    BackgroundColor="#0E7C7B"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="48"
                    VerticalOptions="Center" />
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding AvisoApi}"
               IsVisible="{Binding TieneAvisoApi}"
               FontSize="12"
               TextColor="#8A6D00"
               BackgroundColor="#FFF3CD"
               Padding="10,6" />

        <CollectionView Grid.Row="2"
                        IsVisible="{Binding ListaVisible}"
                        ItemsSource="{Binding Tratamientos}"
                        EmptyView="No hay tratamientos registrados.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,12"
                           Margin="0,0,0,10"
                           StrokeShape="{RoundRectangle CornerRadius=12}"
                           BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerTratamientoCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}" FontSize="15" FontAttributes="Bold" TextColor="#1A2B3C" />
                                <Label Text="{Binding Descripcion}" FontSize="13" TextColor="#5A6B7A" />
                                <Label Text="{Binding DuracionMinutos, StringFormat='{0} min'}" FontSize="12" TextColor="#5A6B7A" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding Precio, StringFormat='${0:0.00}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0E7C7B"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- 2026-11-25 (loading): se ve mientras se valida el acceso al API. -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           Color="#0E7C7B"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <Label Grid.Row="3"
               Text="Toca un tratamiento para editarlo o eliminarlo. El precio de las citas ya cobradas no cambia."
               FontSize="12"
               TextColor="#7A8A99" />

    </Grid>

</ContentPage>
