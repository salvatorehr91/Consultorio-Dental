<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui_ClinicaDental.PacientesPage"
             Title="Pacientes"
             BackgroundColor="#F4F7F9">

    <!-- 2026-11-19: mismo arreglo que en CitasPage. La raíz era un
         VerticalStackLayout y el CollectionView pedía altura infinita,
         así que con muchos pacientes la lista no desplazaba. Ahora la
         raíz es un Grid y la lista vive en una fila "*" (acotada, con
         scroll propio). -->
    <Grid Padding="20,16"
          RowSpacing="14"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Start">
            <VerticalStackLayout Spacing="2">
                <Label Text="Pacientes"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#0F3556" />
                <Label Text="{Binding TotalPacientesTexto}"
                       FontSize="14"
                       TextColor="#5A6B7A" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="＋ Nuevo"
                    Command="{Binding NuevoPacienteCommand}"
                    BackgroundColor="#0E7C7B"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="48"
                    VerticalOptions="Center" />
        </Grid>

        <!-- 2026-11-19: esta página NO tenía el aviso del API. Cuando
             la llamada fallaba, mostraba los datos de ejemplo sin decir
             nada, así que parecía que "no se conectaba" sin más pista.
             CitasPage y TratamientosPage sí lo tienen. Con este Label,
             si el API no responde, se ve el motivo exacto en amarillo. -->
        <Label Grid.Row="1"
               Text="{Binding AvisoApi}"
               IsVisible="{Binding TieneAvisoApi}"
               FontSize="12"
               TextColor="#8A6D00"
               BackgroundColor="#FFF3CD"
               Padding="10,6" />

        <SearchBar Grid.Row="2" Placeholder="Buscar por nombre o teléfono…"
                   Text="{Binding TextoBusqueda}"
                   BackgroundColor="White"
                   TextColor="Black" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding PacientesFiltrados}"
                        EmptyView="No hay pacientes que coincidan con la búsqueda.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,12"
                           Margin="0,0,0,10"
                           StrokeShape="{RoundRectangle CornerRadius=12}"
                           BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerPacienteCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Padding="0"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   StrokeShape="{RoundRectangle CornerRadius=22}"
                                   BackgroundColor="#0E7C7B"
                                   VerticalOptions="Center">
                                <Label Text="{Binding Iniciales}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding NombreCompleto}" FontSize="15" FontAttributes="Bold" TextColor="#1A2B3C" />
                                <Label Text="{Binding Telefono}" FontSize="13" TextColor="#5A6B7A" />
                                <Label Text="{Binding Email}" FontSize="12" TextColor="#5A6B7A" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Text="Toca un paciente para ver sus datos. Desde ahí puedes crearle una cita."
               FontSize="12"
               TextColor="#7A8A99" />

    </Grid>

</ContentPage>